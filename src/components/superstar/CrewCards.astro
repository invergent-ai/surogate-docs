---
// The crew as cards: the face each agent wears in Superstar, its job, and the playbooks it works in.
import { CREW } from '../../data/superstar-crew.mjs';
import { PLAYBOOKS } from '../../data/superstar-playbooks.mjs';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const crew = CREW.map((c) => ({ ...c, in: PLAYBOOKS.filter((p) => p.crew.includes(c.name)) }));
---

<ul class="crew not-content" data-compact={compact ? '' : undefined}>
  {
    crew.map((c) => (
      <li>
        <img src={c.face} alt="" width="44" height="44" />
        <div>
          <a class="n" href={`/superstar/crew/#${c.anchor}`}>{c.name}</a>
          <p>{c.job}</p>
          {!compact && c.in.length > 0 && (
            <p class="in">
              In {c.in.length} playbook{c.in.length > 1 ? 's' : ''}:{' '}
              {c.in.slice(0, 3).map((p, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/superstar/playbooks/${p.id}/`}>{p.t}</a>
                </>
              ))}
              {c.in.length > 3 && ` and ${c.in.length - 3} more`}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .crew {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.75rem;
  }
  li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 0.9rem;
    background: var(--d-surface);
    border: 1px solid var(--d-line);
  }
  img {
    flex: none;
    width: 44px;
    height: 44px;
  }
  .n {
    font-weight: 650;
    color: var(--d-ink);
    text-decoration: none;
  }
  .n:hover {
    color: var(--d-link);
  }
  p {
    margin: 0.2rem 0 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--d-text);
  }
  .in {
    font-size: 0.8rem;
    margin-top: 0.45rem;
  }
  .in a {
    color: var(--d-link);
  }
</style>
