---
// The facts at the top of a playbook: how long, who on the crew (with their faces) and the template it starts from.
import { PLAYBOOKS } from '../../data/superstar-playbooks.mjs';
import { crewOf } from '../../data/superstar-crew.mjs';

interface Props {
  id: string;
  template: string;
}
const { id, template } = Astro.props;
const p = PLAYBOOKS.find((x) => x.id === id)!;
---

<dl class="meta not-content">
  <div>
    <dt>Time</dt>
    <dd>{p.time}</dd>
  </div>
  <div>
    <dt>Crew</dt>
    <dd class="crew">
      {
        p.crew.map((n) => {
          const c = crewOf(n);
          return (
            <a href={`/superstar/crew/#${c?.anchor ?? ''}`}>
              {c && <img src={c.face} alt="" width="22" height="22" />}
              {n}
            </a>
          );
        })
      }
    </dd>
  </div>
  <div>
    <dt>Template</dt>
    <dd>{template}</dd>
  </div>
</dl>

<style>
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 1rem 0 1.5rem;
    padding: 0.9rem 1rem;
    background: var(--d-soft);
    border: 1px solid var(--d-line);
  }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--d-text);
  }
  dd {
    margin: 0.25rem 0 0;
    color: var(--d-ink);
    font-size: 0.92rem;
  }
  .crew {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.8rem;
  }
  .crew a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--d-ink);
    text-decoration: none;
  }
  .crew a:hover {
    color: var(--d-link);
  }
  img {
    width: 22px;
    height: 22px;
  }
</style>
