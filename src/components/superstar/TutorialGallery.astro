---
// Every tutorial that is in public/videos/superstar, playable in place, each with a link to its playbook.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { PLAYBOOKS } from '../../data/superstar-playbooks.mjs';

const list = PLAYBOOKS.filter((p) => p.video && existsSync(join(process.cwd(), 'public', `videos/superstar/${p.video}.mp4`)));
---

{
  list.length === 0 ? (
    <p>The tutorials are on their way.</p>
  ) : (
    <ul class="gallery not-content">
      {list.map((p) => (
        <li>
          <video controls preload="none" playsinline poster={`/videos/superstar/${p.video}.jpg`} src={`/videos/superstar/${p.video}.mp4`} />
          <span class="grp">{p.grp}</span>
          <a href={`/superstar/playbooks/${p.id}/`}>{p.t}</a>
          <span class="lead">{p.lead}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1.5rem 1rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--d-codebg);
    border: 1px solid var(--d-line);
    margin-bottom: 0.4rem;
  }
  .grp {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--d-link);
  }
  a {
    font-weight: 650;
    color: var(--d-ink);
    text-decoration: none;
  }
  a:hover {
    color: var(--d-link);
  }
  .lead {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--d-text);
  }
</style>
