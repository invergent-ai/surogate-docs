---
// The playbooks as cards: the tutorial's poster when there is one, the job, who does it and how long it takes.
// `filter` adds group chips that hide the other groups; without JavaScript every card stays visible.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { PLAYBOOKS } from '../../data/superstar-playbooks.mjs';
import { crewOf } from '../../data/superstar-crew.mjs';

interface Props {
  group?: string;
  ids?: string[];
  filter?: boolean;
}
const { group, ids, filter = false } = Astro.props;
const GROUPS = ['Sales', 'Marketing', 'Content', 'Growth ops'];
const has = (p: string) => existsSync(join(process.cwd(), 'public', p));
const list = PLAYBOOKS.filter((p) => (!group || p.grp === group) && (!ids || ids.includes(p.id))).map((p) => ({
  ...p,
  poster: p.video && has(`/videos/superstar/${p.video}.jpg`) ? `/videos/superstar/${p.video}.jpg` : null,
  watch: Boolean(p.video && has(`/videos/superstar/${p.video}.mp4`)),
}));
---

<div class="pb not-content" data-pb>
  {
    filter && (
      <div class="chips" role="group" aria-label="Show playbooks for">
        <button type="button" aria-pressed="true" data-grp="">All {list.length}</button>
        {GROUPS.map((g) => (
          <button type="button" aria-pressed="false" data-grp={g}>
            {g} {list.filter((p) => p.grp === g).length}
          </button>
        ))}
        <button type="button" aria-pressed="false" data-grp="watch">▶ With a tutorial</button>
      </div>
    )
  }
  <ul class="grid">
    {
      list.map((p) => (
        <li data-grp={p.grp} data-watch={p.watch ? '' : undefined}>
          <a href={`/superstar/playbooks/${p.id}/`}>
            <span class="media" data-g={p.grp}>
              {p.poster ? <img src={p.poster} alt="" loading="lazy" width="640" height="360" /> : <span class="grp">{p.grp}</span>}
              {p.watch && <span class="play">▶ Tutorial</span>}
            </span>
            <span class="body">
              {p.poster && <span class="kicker">{p.grp}</span>}
              <span class="t">{p.t}</span>
              <span class="lead">{p.lead}</span>
            </span>
            <span class="foot">
              <span class="faces">
                {p.crew.map((n) => {
                  const c = crewOf(n);
                  return c ? <img src={c.face} alt={n} title={n} width="22" height="22" /> : null;
                })}
              </span>
              <span class="time">{p.time}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pb]')) {
    const chips = root.querySelectorAll<HTMLButtonElement>('.chips button');
    chips.forEach((b) =>
      b.addEventListener('click', () => {
        const g = b.dataset.grp;
        chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        root.querySelectorAll<HTMLElement>('li').forEach((li) => {
          li.hidden = g === 'watch' ? !('watch' in li.dataset) : Boolean(g) && li.dataset.grp !== g;
        });
      }),
    );
  }
</script>

<style>
  .pb {
    margin: 1.25rem 0 2rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .chips button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--d-cardline);
    background: transparent;
    color: var(--d-text);
    cursor: pointer;
  }
  .chips button[aria-pressed='true'] {
    background: var(--d-mark);
    border-color: var(--d-mark);
    color: var(--d-markink);
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1rem;
  }
  li[hidden] {
    display: none;
  }
  a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--d-text);
    background: var(--d-surface);
    border: 1px solid var(--d-line);
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  a:hover,
  a:focus-visible {
    border-color: var(--d-link);
    transform: translateY(-2px);
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--d-card);
  }
  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media[data-g='Sales'] { background: linear-gradient(135deg, #14b8a6, #0e7a6f); }
  .media[data-g='Marketing'] { background: linear-gradient(135deg, #ff6b3d, #b4502f); }
  .media[data-g='Content'] { background: linear-gradient(135deg, #8b5cf6, #5b3aa8); }
  .media[data-g='Growth ops'] { background: linear-gradient(135deg, #3b82f6, #1f4f9e); }
  .media:has(img) {
    background: var(--d-card);
  }
  .grp {
    position: absolute;
    left: 0.9rem;
    bottom: 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
  }
  .play {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 0.95rem 0.5rem;
    flex: 1;
  }
  .kicker {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--d-link);
  }
  .t {
    font-weight: 650;
    color: var(--d-ink);
    line-height: 1.3;
  }
  .lead {
    font-size: 0.86rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem 0.85rem;
    font-size: 0.78rem;
  }
  .faces {
    display: flex;
  }
  .faces img {
    width: 22px;
    height: 22px;
    border: 2px solid var(--d-surface);
    margin-right: -6px;
  }
  .time {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: reduce) {
    a { transition: none; }
    a:hover, a:focus-visible { transform: none; }
  }
</style>
