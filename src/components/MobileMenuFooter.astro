---
// The foot of the mobile menu: the two products, the theme switch and Sign in,
// which the nav bar hides on narrow screens.
import ThemeToggle from './ThemeToggle.astro';
import { PRODUCT_HOME, PRODUCT_LABEL, productFor } from '../lib/product.mjs';

const current = productFor(Astro.locals.starlightRoute.id);
---

<div class="mobile-foot" data-docs="mobile-foot">
  <div class="products">
    {
      (['agents', 'keel'] as const).map((product) => (
        <a href={PRODUCT_HOME[product]} aria-current={product === current ? 'page' : undefined}>{PRODUCT_LABEL[product]}</a>
      ))
    }
  </div>
  <div class="row">
    <ThemeToggle />
    <a class="sign-in" href="https://ops.surogate.ai">Sign in</a>
  </div>
</div>

<style>
  .mobile-foot {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0 1.5rem;
    border-top: 1px solid var(--d-line);
  }
  .products {
    display: flex;
    gap: 1.4rem;
  }
  .products a {
    color: var(--d-text);
    text-decoration: none;
    font-size: 0.88rem;
  }
  .products a[aria-current='page'] {
    color: var(--d-ink);
    font-weight: 700;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* The toggle's white outline is drawn for the aubergine nav; in the menu it sits on the page. */
  .row :global(.theme-toggle) {
    color: var(--d-ink);
    border-color: var(--d-cardline);
  }
  .sign-in {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    background: #ffaf10;
    color: #2a102d;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
  }
</style>
