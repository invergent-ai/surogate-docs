---
// Overrides Starlight's SocialIcons to prepend header links. Starlight's header
// exposes no config for arbitrary links — `social` only accepts icons — so this
// override is the supported way to add them.
//
// surogate.ai is a plain text link and Login is the bordered CTA, so the two do
// not compete for the same emphasis: Login is the action, surogate.ai is the
// route back to the product site.
//
// The upstream component takes no slot, so this renders it bare.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="header-nav-link" href="https://surogate.ai">surogate.ai</a>
<a class="header-login" href="https://ops.surogate.ai">Login</a>
<Default />
