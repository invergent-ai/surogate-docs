---
// Previous / next as two bordered boxes, then the slim site footer. The edit
// link lives beside "On this page"; it stays here only on pages without one.
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const { toc } = Astro.locals.starlightRoute;
---

<footer class="docs-footer">
  {!toc && <div class="meta"><EditLink /></div>}
  <Pagination />
  <div class="site-footer" data-docs="site-footer">
    <span><strong>Surogate</strong> © 2026</span>
    <span class="links">
      <a href="https://surogate.ai">surogate.ai</a>
      <a href="https://discord.gg/eVTq93BrQ4">Discord</a>
      <a href="https://github.com/invergent-ai/surogate">GitHub</a>
    </span>
  </div>
</footer>

<style>
  .docs-footer {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 3rem;
  }
  .meta :global(a) {
    font-size: 0.82rem;
    color: var(--d-link);
  }
  .docs-footer :global(.pagination-links a) {
    border: 1px solid var(--d-line);
    box-shadow: none;
    padding: 1rem 1.2rem;
    color: var(--d-text);
    font-size: 0.76rem;
  }
  .docs-footer :global(.pagination-links a:hover) {
    border-color: var(--d-ink);
  }
  .docs-footer :global(.pagination-links svg) {
    display: none;
  }
  .docs-footer :global(.pagination-links .link-title) {
    font-size: 1.06rem;
    font-weight: 800;
    color: var(--d-ink);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.4rem 1.6rem;
    background: #1a0a1c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.82rem;
  }
  .site-footer strong {
    color: #ffffff;
  }
  .links {
    display: flex;
    gap: 1.4rem;
  }
  .links a {
    color: inherit;
  }
  .links a:hover {
    color: #ffffff;
  }
</style>
