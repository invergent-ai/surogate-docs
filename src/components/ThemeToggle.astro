---
// The theme switch: one square button that flips light and dark. The choice is
// stored under Starlight's own key; with nothing stored, Starlight follows the OS.
---

<button type="button" class="theme-toggle" data-docs="theme-toggle" aria-label="Switch theme">
  <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M20 14.5 A8 8 0 1 1 9.5 4 A6.5 6.5 0 0 0 20 14.5 Z"></path>
  </svg>
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M4.9 4.9 L7 7 M17 17 L19.1 19.1 M4.9 19.1 L7 17 M17 7 L19.1 4.9"></path>
  </svg>
</button>

<script>
  import { applyTheme, nextTheme } from '../scripts/theme.mjs';

  const current = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
  const label = () => (current() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    button.setAttribute('aria-label', label());
    button.addEventListener('click', () => {
      applyTheme(nextTheme(current()));
      for (const b of document.querySelectorAll('.theme-toggle')) b.setAttribute('aria-label', label());
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: #ffffff;
  }
  .theme-toggle:focus-visible {
    outline: 2px solid #ffaf10;
    outline-offset: 2px;
  }
  .sun {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: block;
  }
  :global([data-theme='dark']) .moon {
    display: none;
  }
</style>
