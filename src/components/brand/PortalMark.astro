---
// Surogate Portal: a placeholder mark, a white browser window with a header bar
// and two content blocks on a teal square, until a real Portal logo exists.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect width="24" height="24" fill="#0f6b6b"></rect>
  <rect x="4" y="5" width="16" height="14" fill="#ffffff"></rect>
  <rect x="4" y="5" width="16" height="3" fill="#9fd3cf"></rect>
  <rect x="6" y="10" width="5" height="7" fill="#0f6b6b"></rect>
  <rect x="12.5" y="10" width="5.5" height="2.6" fill="#0f6b6b"></rect>
  <rect x="12.5" y="14.4" width="5.5" height="2.6" fill="#0f6b6b"></rect>
</svg>

<style>
  .mark {
    display: block;
    flex: 0 0 auto;
  }
</style>
