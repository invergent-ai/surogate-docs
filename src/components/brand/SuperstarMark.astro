---
// Superstar: the app's amber star badge, reduced to a dark star on an amber square to sit beside the other marks.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect width="24" height="24" fill="#ffaf10"></rect>
  <polygon points="12.00,4.40 14.06,9.77 19.80,10.07 15.33,13.68 16.82,19.23 12.00,16.10 7.18,19.23 8.67,13.68 4.20,10.07 9.94,9.77" fill="#2a102d"></polygon>
</svg>

<style>
  .mark {
    display: block;
    flex: 0 0 auto;
  }
</style>
