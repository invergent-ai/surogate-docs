---
// Surogate DMS: a placeholder mark, a white page with a folded corner and three
// text bars on a plum square, until a real DMS logo exists.
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect width="24" height="24" fill="#9b1f61"></rect>
  <path d="M6.5 4 H14 L17.5 7.5 V20 H6.5 Z" fill="#ffffff"></path>
  <path d="M14 4 V7.5 H17.5 Z" fill="#d9a3bf"></path>
  <rect x="8.4" y="10.2" width="7.2" height="1.3" fill="#9b1f61"></rect>
  <rect x="8.4" y="13" width="7.2" height="1.3" fill="#9b1f61"></rect>
  <rect x="8.4" y="15.8" width="4.6" height="1.3" fill="#9b1f61"></rect>
</svg>

<style>
  .mark {
    display: block;
    flex: 0 0 auto;
  }
</style>
