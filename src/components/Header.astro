---
// The nav bar, the same aubergine bar as surogate.ai in both themes: the docs
// wordmark, the three products, search (surogate.ai on the home page, whose hero
// carries the big search field), the theme switch and Sign in.
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import { PRODUCT_HOME, PRODUCT_LABEL, productFor } from '../lib/product.mjs';

const { id, hasSidebar } = Astro.locals.starlightRoute;
const current = productFor(id);
// Only the home page swaps search for a surogate.ai link: its hero holds the big search field.
const isHome = id === '';
---

<div class="docs-header" data-docs="header" data-has-menu={String(hasSidebar)}>
  <a class="wordmark" href="/">
    <span class="name">Surogate</span><span class="docs">Docs</span>
  </a>
  <div class="products">
    {
      (['agents', 'keel', 'dms'] as const).map((product) => (
        <a
          data-docs="product-link"
          href={PRODUCT_HOME[product]}
          aria-current={product === current ? 'page' : undefined}
        >{PRODUCT_LABEL[product]}</a>
      ))
    }
  </div>
  <div class="tools">
    {isHome ? <a class="site-link" href="https://surogate.ai">surogate.ai</a> : <Search />}
    <ThemeToggle />
    <a class="sign-in" href="https://ops.surogate.ai">Sign in</a>
  </div>
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
    color: #ffffff;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
  }
  .name {
    font-weight: 800;
    font-size: 1.18rem;
    letter-spacing: -0.02em;
  }
  .docs {
    font-weight: 600;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .products {
    display: flex;
    gap: 1.4rem;
    flex: 1 1 auto;
  }
  .products a,
  .site-link {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 0.88rem;
    padding: 0.7rem 0;
    white-space: nowrap;
  }
  .products a[aria-current='page'] {
    color: #ffffff;
    font-weight: 700;
  }
  .products a:hover,
  .site-link:hover {
    color: #ffffff;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-inline-start: auto;
  }
  .sign-in {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    background: #ffaf10;
    color: #2a102d;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    white-space: nowrap;
  }
  .docs-header a:focus-visible {
    outline: 2px solid #ffaf10;
    outline-offset: 2px;
  }

  /* Starlight's search button, as the mockup's compact field. */
  .tools :global(button[data-open-modal]) {
    min-width: 240px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.82rem;
    padding: 0 0.7rem;
    gap: 0.6rem;
  }
  .tools :global(button[data-open-modal] kbd) {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.75);
  }

  /* Three products and the search field crowd the bar between 800 and 1024 px: the field shrinks to its content. */
  @media (max-width: 64rem) {
    .docs-header {
      gap: 1.2rem;
    }
    .products {
      gap: 1rem;
    }
    .tools {
      gap: 0.6rem;
    }
    .tools :global(button[data-open-modal]) {
      min-width: 0;
    }
  }

  /* On phones the products and Sign in move to the menu; pages without a menu keep Sign in. */
  @media (max-width: 50rem) {
    .products,
    .site-link,
    [data-has-menu='true'] .sign-in {
      display: none;
    }
    .docs-header {
      gap: 1rem;
    }
    .tools :global(button[data-open-modal]) {
      min-width: 0;
    }
  }
</style>
